0014   0000                     .addinstr TZW  *,*    C4 3 ZW 1
0015   0000                     .addinstr TZD  *,*    C6 2 ZD 1
0016   0000                     .addinstr TZL  *,*    C8 2 ZL 1
0017   0000                     .addinstr TSZ  *      C3 3 SZ 1
0018   0000                     .addinstr TSB  *,*    10 2 SB 1
0019   0000                     .addinstr TSB3 *,*,*  20 3 SB 1
0020   0000                     .addinstr TT2  *,*    30 3 T2 1
0021   0000                     .addinstr TT2A *      40 1 T2 1
0022   0000                     .addinstr TT3  *,*    50 3 T3 1
