0026   0000 90 53               TCN  3,5            ; CN  -> 90 53
0027   0002 91 35               TC5  3,5            ; C5  -> 91 35
0028   0004 92 11 22 33         T3A  11h,22h,33h    ; 3A  -> 92 11 22 33
0029   0008 A2                  TR3  $+3            ; R3  -> A2         delta 2, A0|2
0030   0009 C2 12               TZW  0E1h,0E2h      ; ZW  -> C2 12      both working regs: opcode C4->C2, one byte
0031   000B C4 22 11            TZW  11h,22h        ; ZW  -> C4 22 11   not working regs: byte-swapped pair
0032   000E F6 03               TZD  3,$+5          ; ZD  -> F6 03      opcode C6|(3<<4), delta 3
0033   0010 E8 55               TZL  55h,2          ; ZL  -> E8 55      opcode C8|(2<<4), immed 0x55
0034   0012 B3 44               TSZ  44h            ; SZ  -> B3 44      zero page: C3->B3, one byte
0035   0014 C3 12 34            TSZ  1234h          ; SZ  -> C3 12 34   not zero page: byte-swapped
0036   0017 16 44               TSB  44h,3          ; SB  -> 16 44      opcode 10|(3<<1), addr 0x44
0037   0019 26 44 01            TSB3 44h,3,$+4      ; SB  -> 26 44 01   opcode 20|(3<<1), delta 1
0038   001C 37 12 34            TT2  1234h,7        ; T2  -> 37 12 34   opcode 30|7, const byte-swapped
0039   001F 45                  TT2A 5              ; T2  -> 45         opcode 40|5, one operand
0040   0020 51 56 78            TT3  1,5678h        ; T3  -> 51 56 78   opcode 50|1, const byte-swapped
0041   0023 81 00               TT4  1,2            ; T4  -> 81 00      opcode 1|(2<<6)=0x81, LSFIRST
0042   0025 73                  TT6  3,50h          ; T6  -> 73         opcode 60|3|50
