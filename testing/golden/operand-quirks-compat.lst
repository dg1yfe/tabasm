0001   0000             ; Operand text: whitespace, and a radix prefix with nothing to work on.
0002   0000             ;
0003   0000             ; Whitespace is removed from an operand before it is evaluated, so `.byte 3 4`
0004   0000             ; is the one byte 0x22 -- but not inside a quoted character, where the space IS
0005   0000             ; the value. Closing up that gap would leave the quote as the character.
0006   0000             ;
0007   0000             ; `%` introduces a binary constant, and is not symmetric with `$`: a `$` with no
0008   0000             ; hex digit is the counter, while a `%` with no binary digit is an empty binary
0009   0000             ; constant. By default that is diagnosed and yields 0. `--compatibility`
0010   0000             ; restores the original, where the prefix contributes nothing and the value
0011   0000             ; after it is taken -- which is what makes `#%NAME` work when NAME is a macro
0012   0000             ; expanding to a parenthesised expression. This case is assembled both ways.
0013   0000                     .org  0
0014   0000             #define BIT   (1 << 2)
0015   0000             #define BITS  0101
0016   0000             
0017   0000 C6 20               ldab  #' '              ; the space, $20
0018   0002 C6 41               ldab  #'A'
0019   0004 C6 05               ldab  #%BITS            ; binary 0101 = 5, a real binary constant
0020   0006 C6 04               ldab  #BIT
0021   0008 22                  .byte 3 4               ; whitespace removed: one byte, 0x22
0022   0009 19                  .byte 1+2 4             ; likewise 1+24 = 25
0023   000A 61 20 62            .byte "a b"             ; kept inside a string
0024   000D C6 04               ldab  #%BIT             ; no binary digit: diagnosed by default
0025   000F 05                  .byte %5                ; likewise
0026   0010                     .end
