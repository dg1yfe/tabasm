0001   0000             ; Z80 smoke test.
0002   0000             ;
0003   0000             ; Short on purpose: a handful of instructions that need no operand evaluation,
0004   0000             ; every data directive, a label and an equate. Its value is breadth across the
0005   0000             ; targets and the object formats, not depth -- testing/conformance.rs covers
0006   0000             ; every table row.
0007   0000                     .org  0
0008   0000             val     .equ  $12
0009   0000 01 02 03            .byte 1,2,3
0010   0003 34 12               .word $1234
0011   0005 73 6D 6F 6B         .text "smoke"
0011   0009 65 
0012   000A 8E                  ADC   A,(HL)
0013   000B 86                  ADD   A,(HL)
0014   000C A6                  AND   (HL)
0015   000D 3F                  CCF   
0016   000E BE                  CP    (HL)
0017   000F ED A9               CPD   
0018   0011 ED B9               CPDR  
0019   0013 ED B1               CPIR  
0020   0015 04          here:   .byte 4
0021   0016                     .block 4
0022   001A 12                  .byte val
0023   001B                     .end
