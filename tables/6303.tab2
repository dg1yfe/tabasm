; HD6303 -- Hitachi CMOS 6801/6803 derivative.
;
; The HD6303 is a superset of the MC6801/6803, which is a superset of the
; MC6800. This table is 6800.tab2 with the 68HC11-only rows removed and the
; six HD6303 instructions added: AIM, EIM, OIM and TIM (read-modify-write with
; an immediate mask, direct or indexed), SLP (sleep until interrupt) and XGDX
; (exchange D and X). Note XGDX is 18 here; the 68HC11 instruction of the same
; name is 8F, which is why that processor's rows do not belong in this table.
;
; The opcodes are as published in Hitachi's HD6303 data sheet.
%format         2
%banner         "Table-driven HD6303 Assembler"
%opcode-order   ms-first
%address-unit   byte
%aux-registers  2
%columns        mnemonic operands opcode op-bytes arg-bytes rule
ABA - 1B 1 0 plain
ABX - 3A 1 0 plain
ADCA #<expr> 89 1 1 plain
ADCA <expr>,X A9 1 1 plain
ADCA <expr> B9 1 2 zero-page-moto
ADCB #<expr> C9 1 1 plain
ADCB <expr>,X E9 1 1 plain
ADCB <expr> F9 1 2 zero-page-moto
ADDA #<expr> 8B 1 1 plain
ADDA <expr>,X AB 1 1 plain
ADDA <expr> BB 1 2 zero-page-moto
ADDB #<expr> CB 1 1 plain
ADDB <expr>,X EB 1 1 plain
ADDB <expr> FB 1 2 zero-page-moto
ADDD #<expr> C3 1 2 swap-bytes
ADDD <expr>,X E3 1 1 plain
ADDD <expr> F3 1 2 zero-page-moto
AIM #<expr>,<expr>,X 61 1 2 combine
AIM #<expr>,<expr> 71 1 2 combine
ANDA #<expr> 84 1 1 plain
ANDA <expr>,X A4 1 1 plain
ANDA <expr> B4 1 2 zero-page-moto
ANDB #<expr> C4 1 1 plain
ANDB <expr>,X E4 1 1 plain
ANDB <expr> F4 1 2 zero-page-moto
ASL <expr>,X 68 1 1 plain
ASL <expr> 78 1 2 swap-bytes
ASLA - 48 1 0 plain
ASLB - 58 1 0 plain
ASLD - 05 1 0 plain
ASR <expr>,X 67 1 1 plain
ASR <expr> 77 1 2 swap-bytes
ASRA - 47 1 0 plain
ASRB - 57 1 0 plain
BCC <expr> 24 1 1 rel8
BCS <expr> 25 1 1 rel8
BEQ <expr> 27 1 1 rel8
BGE <expr> 2C 1 1 rel8
BGT <expr> 2E 1 1 rel8
BHI <expr> 22 1 1 rel8
BHS <expr> 24 1 1 rel8
BITA #<expr> 85 1 1 plain
BITA <expr>,X A5 1 1 plain
BITA <expr> B5 1 2 zero-page-moto
BITB #<expr> C5 1 1 plain
BITB <expr>,X E5 1 1 plain
BITB <expr> F5 1 2 zero-page-moto
BLE <expr> 2F 1 1 rel8
BLO <expr> 25 1 1 rel8
BLS <expr> 23 1 1 rel8
BLT <expr> 2D 1 1 rel8
BMI <expr> 2B 1 1 rel8
BNE <expr> 26 1 1 rel8
BPL <expr> 2A 1 1 rel8
BRA <expr> 20 1 1 rel8
BRN <expr> 21 1 1 rel8
BSR <expr> 8D 1 1 rel8
BVC <expr> 28 1 1 rel8
BVS <expr> 29 1 1 rel8
CBA - 11 1 0 plain
CLC - 0C 1 0 plain
CLI - 0E 1 0 plain
CLR <expr>,X 6F 1 1 plain
CLR <expr> 7F 1 2 swap-bytes
CLRA - 4F 1 0 plain
CLRB - 5F 1 0 plain
CLV - 0A 1 0 plain
CMPA #<expr> 81 1 1 plain
CMPA <expr>,X A1 1 1 plain
CMPA <expr> B1 1 2 zero-page-moto
CMPB #<expr> C1 1 1 plain
CMPB <expr>,X E1 1 1 plain
CMPB <expr> F1 1 2 zero-page-moto
COM <expr>,X 63 1 1 plain
COM <expr> 73 1 2 swap-bytes
COMA - 43 1 0 plain
COMB - 53 1 0 plain
CPX #<expr> 8C 1 2 swap-bytes
CPX <expr>,X AC 1 1 plain
CPX <expr> BC 1 2 zero-page-moto
DAA - 19 1 0 plain
DEC <expr>,X 6A 1 1 plain
DEC <expr> 7A 1 2 swap-bytes
DECA - 4A 1 0 plain
DECB - 5A 1 0 plain
DES - 34 1 0 plain
DEX - 09 1 0 plain
EIM #<expr>,<expr>,X 65 1 2 combine
EIM #<expr>,<expr> 75 1 2 combine
EORA #<expr> 88 1 1 plain
EORA <expr>,X A8 1 1 plain
EORA <expr> B8 1 2 zero-page-moto
EORB #<expr> C8 1 1 plain
EORB <expr>,X E8 1 1 plain
EORB <expr> F8 1 2 zero-page-moto
INC <expr>,X 6C 1 1 plain
INC <expr> 7C 1 2 swap-bytes
INCA - 4C 1 0 plain
INCB - 5C 1 0 plain
INS - 31 1 0 plain
INX - 08 1 0 plain
JMP <expr>,X 6E 1 1 plain
JMP <expr> 7E 1 2 swap-bytes
JSR <expr>,X AD 1 1 plain
JSR <expr> BD 1 2 zero-page-moto
LDAA #<expr> 86 1 1 plain
LDAA <expr>,X A6 1 1 plain
LDAA ><expr> B6 1 2 swap-bytes
LDAA <expr> B6 1 2 zero-page-moto
LDAB #<expr> C6 1 1 plain
LDAB <expr>,X E6 1 1 plain
LDAB ><expr> F6 1 2 swap-bytes
LDAB <expr> F6 1 2 zero-page-moto
LDD #<expr> CC 1 2 swap-bytes
LDD <expr>,X EC 1 1 plain
LDD ><expr> FC 1 2 swap-bytes
LDD <expr> FC 1 2 zero-page-moto
LDS #<expr> 8E 1 2 swap-bytes
LDS <expr>,X AE 1 1 plain
LDS ><expr> BE 1 2 swap-bytes
LDS <expr> BE 1 2 zero-page-moto
LDX #<expr> CE 1 2 swap-bytes
LDX <expr>,X EE 1 1 plain
LDX ><expr> FE 1 2 swap-bytes
LDX <expr> FE 1 2 zero-page-moto
LSL <expr>,X 68 1 1 plain
LSL <expr> 78 1 2 swap-bytes
LSLA - 48 1 0 plain
LSLB - 58 1 0 plain
LSLD - 05 1 0 plain
LSR <expr>,X 64 1 1 plain
LSR <expr> 74 1 2 swap-bytes
LSRA - 44 1 0 plain
LSRB - 54 1 0 plain
LSRD - 04 1 0 plain
MUL - 3D 1 0 plain
NEG <expr>,X 60 1 1 plain
NEG <expr> 70 1 2 swap-bytes
NEGA - 40 1 0 plain
NEGB - 50 1 0 plain
NOP - 01 1 0 plain
OIM #<expr>,<expr>,X 62 1 2 combine
OIM #<expr>,<expr> 72 1 2 combine
ORAA #<expr> 8A 1 1 plain
ORAA <expr>,X AA 1 1 plain
ORAA <expr> BA 1 2 zero-page-moto
ORAB #<expr> CA 1 1 plain
ORAB <expr>,X EA 1 1 plain
ORAB <expr> FA 1 2 zero-page-moto
PSHA - 36 1 0 plain
PSHB - 37 1 0 plain
PSHX - 3C 1 0 plain
PULA - 32 1 0 plain
PULB - 33 1 0 plain
PULX - 38 1 0 plain
ROL <expr>,X 69 1 1 plain
ROL <expr> 79 1 2 swap-bytes
ROLA - 49 1 0 plain
ROLB - 59 1 0 plain
ROR <expr>,X 66 1 1 plain
ROR <expr> 76 1 2 swap-bytes
RORA - 46 1 0 plain
RORB - 56 1 0 plain
RTI - 3B 1 0 plain
RTS - 39 1 0 plain
SBA - 10 1 0 plain
SBCA #<expr> 82 1 1 plain
SBCA <expr>,X A2 1 1 plain
SBCA <expr> B2 1 2 zero-page-moto
SBCB #<expr> C2 1 1 plain
SBCB <expr>,X E2 1 1 plain
SBCB <expr> F2 1 2 zero-page-moto
SEC - 0D 1 0 plain
SEI - 0F 1 0 plain
SEV - 0B 1 0 plain
SLP - 1A 1 0 plain
STAA <expr>,X A7 1 1 plain
STAA ><expr> B7 1 2 swap-bytes
STAA <expr> B7 1 2 zero-page-moto
