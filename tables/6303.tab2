STAB ><expr> F7 1 2 swap-bytes
STAB <expr> F7 1 2 zero-page-moto
STD <expr>,X ED 1 1 plain
STD ><expr> FD 1 2 swap-bytes
STD <expr> FD 1 2 zero-page-moto
STOP - CF 1 0 plain
STS <expr>,X AF 1 1 plain
STS ><expr> BF 1 2 swap-bytes
STS <expr> BF 1 2 zero-page-moto
STX <expr>,X EF 1 1 plain
STX ><expr> FF 1 2 swap-bytes
STX <expr> FF 1 2 zero-page-moto
SUBA #<expr> 80 1 1 plain
SUBA <expr>,X A0 1 1 plain
SUBA <expr> B0 1 2 zero-page-moto
SUBB #<expr> C0 1 1 plain
SUBB <expr>,X E0 1 1 plain
SUBB <expr> F0 1 2 zero-page-moto
SUBD #<expr> 83 1 2 swap-bytes
SUBD <expr>,X A3 1 1 plain
SUBD <expr> B3 1 2 zero-page-moto
SWI - 3F 1 0 plain
TAB - 16 1 0 plain
TAP - 06 1 0 plain
TBA - 17 1 0 plain
TEST - 00 1 0 plain
TIM #<expr>,<expr>,X 6B 1 2 combine
TIM #<expr>,<expr> 7B 1 2 combine
TPA - 07 1 0 plain
TST <expr>,X 6D 1 1 plain
TST <expr> 7D 1 2 swap-bytes
TSTA - 4D 1 0 plain
TSTB - 5D 1 0 plain
TSX - 30 1 0 plain
TXS - 35 1 0 plain
WAI - 3E 1 0 plain
XGDX - 18 1 0 plain
