%format         2
%banner         "Table-driven 6805 Assembler"
%opcode-order   ls-first
%address-unit   byte
%aux-registers  2
%columns        mnemonic operands opcode op-bytes arg-bytes rule
ADC #<expr> A9 1 1 plain
ADC ,X F9 1 0 plain
ADC <expr>,X D9 1 2 zero-page-moto
ADC <expr> C9 1 2 zero-page-moto
ADD #<expr> AB 1 1 plain
ADD ,X FB 1 0 plain
ADD <expr>,X DB 1 2 zero-page-moto
ADD <expr> CB 1 2 zero-page-moto
AND #<expr> A4 1 1 plain
AND ,X F4 1 0 plain
AND <expr>,X D4 1 2 zero-page-moto
AND <expr> C4 1 2 zero-page-moto
ASLA - 48 1 0 plain
ASLX - 58 1 0 plain
ASL ,X 78 1 0 plain
ASL <expr>,X 68 1 1 plain
ASL <expr> 38 1 1 plain
ASRA - 47 1 0 plain
ASRX - 57 1 0 plain
ASR ,X 77 1 0 plain
ASR <expr>,X 67 1 1 plain
ASR <expr> 37 1 1 plain
BCC <expr> 24 1 1 rel8
BCLR <expr>,<expr> 11 1 1 bit-moto
BCS <expr> 25 1 1 rel8
BEQ <expr> 27 1 1 rel8
BHCC <expr> 28 1 1 rel8
BHCS <expr> 29 1 1 rel8
BHI <expr> 22 1 1 rel8
BHS <expr> 24 1 1 rel8
BIH <expr> 2F 1 1 rel8
BIL <expr> 2E 1 1 rel8
BIT #<expr> A5 1 1 plain
BIT ,X F5 1 0 plain
BIT <expr>,X D5 1 2 zero-page-moto
BIT <expr> C5 1 2 zero-page-moto
BLO <expr> 25 1 1 rel8
BLS <expr> 23 1 1 rel8
BMC <expr> 2C 1 1 rel8
BMI <expr> 2B 1 1 rel8
BMS <expr> 2D 1 1 rel8
BNE <expr> 26 1 1 rel8
BPL <expr> 2A 1 1 rel8
BRA <expr> 20 1 1 rel8
BRCLR <expr>,<expr>,<expr> 01 1 2 bit-moto
BRN <expr> 21 1 1 rel8
BRSET <expr>,<expr>,<expr> 00 1 2 bit-moto
BSET <expr>,<expr> 10 1 1 bit-moto
BSR <expr> AD 1 1 rel8
CLC - 98 1 0 plain
CLI - 9A 1 0 plain
CLRA - 4F 1 0 plain
CLRX - 5F 1 0 plain
CLR ,X 7F 1 0 plain
CLR <expr>,X 6F 1 1 plain
CLR <expr> 3F 1 1 plain
CMP #<expr> A1 1 1 plain
CMP ,X F1 1 0 plain
CMP <expr>,X D1 1 2 zero-page-moto
CMP <expr> C1 1 2 zero-page-moto
CMPX #<expr> A3 1 1 plain
CMPX ,X F3 1 0 plain
CMPX <expr>,X D3 1 2 zero-page-moto
CMPX <expr> C3 1 2 zero-page-moto
COMA - 43 1 0 plain
COMX - 53 1 0 plain
COM ,X 73 1 0 plain
COM <expr>,X 63 1 1 plain
COM <expr> 33 1 1 plain
CPX #<expr> A3 1 1 plain
CPX ,X F3 1 0 plain
CPX <expr>,X D3 1 2 zero-page-moto
CPX <expr> C3 1 2 zero-page-moto
DECA - 4A 1 0 plain
DECX - 5A 1 0 plain
DEX - 5A 1 0 plain
DEC ,X 7A 1 0 plain
DEC <expr>,X 6A 1 1 plain
DEC <expr> 3A 1 1 plain
EOR #<expr> A8 1 1 plain
EOR ,X F8 1 0 plain
EOR <expr>,X D8 1 2 zero-page-moto
EOR <expr> C8 1 2 zero-page-moto
INCA - 4C 1 0 plain
INCX - 5C 1 0 plain
INX - 5C 1 0 plain
INC ,X 7C 1 0 plain
INC <expr>,X 6C 1 1 plain
INC <expr> 3C 1 1 plain
JMP ,X FC 1 0 plain
JMP <expr>,X DC 1 2 zero-page-moto
JMP <expr> CC 1 2 zero-page-moto
JSR ,X FD 1 0 plain
JSR <expr>,X DD 1 2 zero-page-moto
JSR <expr> CD 1 2 zero-page-moto
LDA #<expr> A6 1 1 plain
LDA ,X F6 1 0 plain
LDA <expr>,X D6 1 2 zero-page-moto
LDA <expr> C6 1 2 zero-page-moto
LDX #<expr> AE 1 1 plain
LDX ,X FE 1 0 plain
LDX <expr>,X DE 1 2 zero-page-moto
LDX <expr> CE 1 2 zero-page-moto
LSLA - 48 1 0 plain
LSLX - 58 1 0 plain
LSL ,X 78 1 0 plain
LSL <expr>,X 68 1 1 plain
LSL <expr> 38 1 1 plain
LSRA - 44 1 0 plain
LSRX - 54 1 0 plain
LSR ,X 74 1 0 plain
LSR <expr>,X 64 1 1 plain
LSR <expr> 34 1 1 plain
MUL - 42 1 0 plain class=4
NEGA - 40 1 0 plain
NEGX - 50 1 0 plain
NEG ,X 70 1 0 plain
NEG <expr>,X 60 1 1 plain
NEG <expr> 30 1 1 plain
NOP - 9D 1 0 plain
ORA #<expr> AA 1 1 plain
ORA ,X FA 1 0 plain
ORA <expr>,X DA 1 2 zero-page-moto
ORA <expr> CA 1 2 zero-page-moto
ROLA - 49 1 0 plain
ROLX - 59 1 0 plain
ROL ,X 79 1 0 plain
ROL <expr>,X 69 1 1 plain
ROL <expr> 39 1 1 plain
RORA - 46 1 0 plain
RORX - 56 1 0 plain
ROR ,X 76 1 0 plain
ROR <expr>,X 66 1 1 plain
ROR <expr> 36 1 1 plain
RSP - 9C 1 0 plain
RTI - 80 1 0 plain
RTS - 81 1 0 plain
SBC #<expr> A2 1 1 plain
SBC ,X F2 1 0 plain
SBC <expr>,X D2 1 2 zero-page-moto
SBC <expr> C2 1 2 zero-page-moto
SEC - 99 1 0 plain
SEI - 9B 1 0 plain
STA ,X F7 1 0 plain
STA <expr>,X D7 1 2 zero-page-moto
STA <expr> C7 1 2 zero-page-moto
STOP - 8E 1 0 plain class=2
STX ,X FF 1 0 plain
STX <expr>,X DF 1 2 zero-page-moto
STX <expr> CF 1 2 zero-page-moto
SUB #<expr> A0 1 1 plain
SUB ,X F0 1 0 plain
SUB <expr>,X D0 1 2 zero-page-moto
SUB <expr> C0 1 2 zero-page-moto
SWI - 83 1 0 plain
TAX - 97 1 0 plain
TSTA - 4D 1 0 plain
TSTX - 5D 1 0 plain
TST ,X 7D 1 0 plain
TST <expr>,X 6D 1 1 plain
TST <expr> 3D 1 1 plain
TXA - 9F 1 0 plain
WAIT - 8F 1 0 plain class=2
