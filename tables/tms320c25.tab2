%format         2
%banner         "Table-driven TMS320C25 Assembler"
%opcode-order   ms-first
%address-unit   word
%aux-registers  8
%regset         "*BR0+" mask=F0 class=1
%regset         "*BR0-" mask=C0 class=1
%regset         "*0+" mask=E0 class=1
%regset         "*0-" mask=D0 class=1
%regset         "*+" mask=A0 class=1
%regset         "*-" mask=90 class=1
%regset         "*" mask=80 class=1
%columns        mnemonic operands opcode op-bytes arg-bytes rule
ABS - CE1B 2 0 plain
ADD <reg>,<expr>,<expr> 0088 2 0 tms-fold valid-mask=F00 shift=8
ADD <reg>,<expr> 0080 2 0 tms-fold valid-mask=F00 shift=8
ADD <reg> 0080 2 0 plain
ADD <expr>,<expr> 0000 2 0 tms-dma valid-mask=F00 shift=8
ADD <expr> 0000 2 0 tms-fold valid-mask=7F
ADDC <reg>,<expr> 4388 2 0 tms-fold valid-mask=7
ADDC <reg> 4380 2 0 plain
ADDC <expr> 4300 2 0 tms-fold valid-mask=7F
