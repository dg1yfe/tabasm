%format         2
%banner         "Table-driven 8096 Assembler"
%opcode-order   ms-first
%address-unit   byte
%aux-registers  2
%columns        mnemonic operands opcode op-bytes arg-bytes rule
ADD <expr>,<expr>,[<expr>]+ 46 1 3 i8096-combine field-mask=FEFEFE set-bits=1
ADD <expr>,<expr>,[<expr>] 46 1 3 i8096-combine field-mask=FEFEFE
ADD <expr>,<expr>,<expr>[<expr>] 47 1 5 i8096-indexed field-mask=FEFEFE
ADD <expr>,<expr>,#<expr> 45 1 4 i8096-combine field-mask=FEFEFFFF
ADD <expr>,[<expr>]+ 66 1 2 i8096-combine field-mask=FFFE set-bits=1
