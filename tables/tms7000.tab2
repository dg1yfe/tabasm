SBB %<expr>,B 5B 1 1 plain
SBB %<expr>,<expr> 7B 1 2 combine
SBB <expr>,A 1B 1 1 plain
SBB <expr>,B 3B 1 1 plain
SBB <expr>,<expr> 4B 1 2 combine
SETC - 07 1 0 plain
STA @<expr>(B) AB 1 2 swap-bytes
STA @<expr>[B] AB 1 2 swap-bytes
STA @<expr> 8B 1 2 swap-bytes
STA *<expr> 9B 1 1 plain
STSP - 09 1 0 plain
SUB B,A 6A 1 0 plain
SUB %<expr>,A 2A 1 1 plain
SUB %<expr>,B 5A 1 1 plain
SUB %<expr>,<expr> 7A 1 2 combine
SUB <expr>,A 1A 1 1 plain
SUB <expr>,B 3A 1 1 plain
SUB <expr>,<expr> 4A 1 2 combine
SWAP A B7 1 0 plain
SWAP B C7 1 0 plain
SWAP <expr> D7 1 1 plain
TRAP <expr> FF 1 0 tms7000-trap
TST A B0 1 0 plain
TSTA - B0 1 0 plain
TST B C1 1 0 plain
TSTB - C1 1 0 plain
XCHB A B6 1 0 plain
XCHB <expr> D6 1 1 plain
XOR B,A 65 1 0 plain
XOR %<expr>,A 25 1 1 plain
XOR %<expr>,B 55 1 1 plain
XOR %<expr>,<expr> 75 1 2 combine
XOR <expr>,A 15 1 1 plain
XOR <expr>,B 35 1 1 plain
XOR <expr>,<expr> 45 1 2 combine
XORP A,<expr> 85 1 1 plain
XORP B,<expr> 95 1 1 plain
XORP %<expr>,<expr> A5 1 2 combine
