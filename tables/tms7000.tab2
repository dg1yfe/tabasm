%format         2
%banner         "Table-driven TMS7000 Assembler"
%opcode-order   ls-first
%address-unit   byte
%aux-registers  2
%columns        mnemonic operands opcode op-bytes arg-bytes rule
ADC B,A 69 1 0 plain
ADC %<expr>,A 29 1 1 plain
ADC %<expr>,B 59 1 1 plain
ADC %<expr>,<expr> 79 1 2 combine
ADC <expr>,A 19 1 1 plain
ADC <expr>,B 39 1 1 plain
ADC <expr>,<expr> 49 1 2 combine
ADD B,A 68 1 0 plain
ADD %<expr>,A 28 1 1 plain
ADD %<expr>,B 58 1 1 plain
ADD %<expr>,<expr> 78 1 2 combine
ADD <expr>,A 18 1 1 plain
ADD <expr>,B 38 1 1 plain
ADD <expr>,<expr> 48 1 2 combine
AND B,A 63 1 0 plain
AND %<expr>,A 23 1 1 plain
AND %<expr>,B 53 1 1 plain
AND %<expr>,<expr> 73 1 2 combine
AND <expr>,A 13 1 1 plain
AND <expr>,B 33 1 1 plain
AND <expr>,<expr> 43 1 2 combine
ANDP A,<expr> 83 1 1 plain
ANDP B,<expr> 93 1 1 plain
ANDP %<expr>,<expr> A3 1 2 combine
BTJO B,A,<expr> 66 1 1 rel8
BTJO %<expr>,A,<expr> 26 1 2 combine-rel
BTJO %<expr>,B,<expr> 56 1 2 combine-rel
BTJO %<expr>,<expr>,<expr> 76 1 3 three-rel
BTJO <expr>,A,<expr> 16 1 2 combine-rel
BTJO <expr>,B,<expr> 36 1 2 combine-rel
BTJO <expr>,<expr>,<expr> 46 1 3 three-rel
BTJOP A,<expr>,<expr> 86 1 2 combine-rel
BTJOP B,<expr>,<expr> 96 1 2 combine-rel
BTJOP %<expr>,<expr>,<expr> A6 1 3 three-rel
BTJZ B,A,<expr> 67 1 1 rel8
BTJZ %<expr>,A,<expr> 27 1 2 combine-rel
BTJZ %<expr>,B,<expr> 57 1 2 combine-rel
BTJZ %<expr>,<expr>,<expr> 77 1 3 three-rel
BTJZ <expr>,A,<expr> 17 1 2 combine-rel
BTJZ <expr>,B,<expr> 37 1 2 combine-rel
BTJZ <expr>,<expr>,<expr> 47 1 3 three-rel
BTJZP A,<expr>,<expr> 87 1 2 combine-rel
BTJZP B,<expr>,<expr> 97 1 2 combine-rel
BTJZP %<expr>,<expr>,<expr> A7 1 3 three-rel
BR @<expr>(B) AC 1 2 swap-bytes
BR @<expr>[B] AC 1 2 swap-bytes
BR @<expr> 8C 1 2 swap-bytes
BR *<expr> 9C 1 1 plain
CALL @<expr>(B) AE 1 2 swap-bytes
CALL @<expr>[B] AE 1 2 swap-bytes
CALL @<expr> 8E 1 2 swap-bytes
CALL *<expr> 9E 1 1 plain
CLR A B5 1 0 plain
CLR B C5 1 0 plain
CLR <expr> D5 1 1 plain
CLRC - B0 1 0 plain
CMP B,A 6D 1 0 plain
CMP %<expr>,A 2D 1 1 plain
CMP %<expr>,B 5D 1 1 plain
CMP %<expr>,<expr> 7D 1 2 combine
CMP <expr>,A 1D 1 1 plain
CMP <expr>,B 3D 1 1 plain
CMP <expr>,<expr> 4D 1 2 combine
CMPA @<expr>(B) AD 1 2 swap-bytes
CMPA @<expr>[B] AD 1 2 swap-bytes
CMPA @<expr> 8D 1 2 swap-bytes
CMPA *<expr> 9D 1 1 plain
DAC B,A 6E 1 0 plain
DAC %<expr>,A 2E 1 1 plain
DAC %<expr>,B 5E 1 1 plain
DAC %<expr>,<expr> 7E 1 2 combine
DAC <expr>,A 1E 1 1 plain
DAC <expr>,B 3E 1 1 plain
DAC <expr>,<expr> 4E 1 2 combine
DEC A B2 1 0 plain
DEC B C2 1 0 plain
DEC <expr> D2 1 1 plain
DECD A BB 1 0 plain
DECD B CB 1 0 plain
DECD <expr> DB 1 1 plain
DINT - 06 1 0 plain
DJNZ A,<expr> BA 1 1 rel8
DJNZ B,<expr> CA 1 1 rel8
DJNZ <expr>,<expr> DA 1 2 combine-rel
DSB B,A 6F 1 0 plain
DSB %<expr>,A 2F 1 1 plain
DSB %<expr>,B 5F 1 1 plain
DSB %<expr>,<expr> 7F 1 2 combine
DSB <expr>,A 1F 1 1 plain
DSB <expr>,B 3F 1 1 plain
DSB <expr>,<expr> 4F 1 2 combine
EINT - 05 1 0 plain
IDLE - 01 1 0 plain
INC A B3 1 0 plain
INC B C3 1 0 plain
INC <expr> D3 1 1 plain
INV A B4 1 0 plain
INV B C4 1 0 plain
INV <expr> D4 1 1 plain
JMP <expr> E0 1 1 rel8
JC <expr> E3 1 1 rel8
JEQ <expr> E2 1 1 rel8
JGE <expr> E5 1 1 rel8
JGT <expr> E4 1 1 rel8
JHS <expr> E3 1 1 rel8
JL <expr> E7 1 1 rel8
JN <expr> E1 1 1 rel8
