JNE <expr> E6 1 1 rel8
JNZ <expr> E6 1 1 rel8
JP <expr> E4 1 1 rel8
JPZ <expr> E5 1 1 rel8
JZ <expr> E2 1 1 rel8
LDA @<expr>(B) AA 1 2 swap-bytes
LDA @<expr>[B] AA 1 2 swap-bytes
LDA @<expr> 8A 1 2 swap-bytes
LDA *<expr> 9A 1 1 plain
LDSP - 0D 1 0 plain
MOV A,B C0 1 0 plain
MOV B,A 62 1 0 plain
MOV A,<expr> D0 1 1 plain
MOV B,<expr> D1 1 1 plain
MOV %<expr>,A 22 1 1 plain
MOV %<expr>,B 52 1 1 plain
MOV %<expr>,<expr> 72 1 2 combine
MOV <expr>,A 12 1 1 plain
MOV <expr>,B 32 1 1 plain
MOV <expr>,<expr> 42 1 2 combine
MOVD %<expr>[B],<expr> A8 1 3 combine-swapped
MOVD %<expr>,<expr> 88 1 3 combine-swapped
MOVD <expr>,<expr> 98 1 2 combine
MOVP A,<expr> 82 1 1 plain
MOVP B,<expr> 92 1 1 plain
MOVP %<expr>,<expr> A2 1 2 combine
MOVP <expr>,A 80 1 1 plain
MOVP <expr>,B 91 1 1 plain
MPY B,A 6C 1 0 plain
MPY %<expr>,A 2C 1 1 plain
MPY %<expr>,B 5C 1 1 plain
MPY %<expr>,<expr> 7C 1 2 combine
MPY <expr>,A 1C 1 1 plain
MPY <expr>,B 3C 1 1 plain
MPY <expr>,<expr> 4C 1 2 combine
NOP - 00 1 0 plain
OR B,A 64 1 0 plain
OR %<expr>,A 24 1 1 plain
OR %<expr>,B 54 1 1 plain
OR %<expr>,<expr> 74 1 2 combine
OR <expr>,A 14 1 1 plain
OR <expr>,B 34 1 1 plain
OR <expr>,<expr> 44 1 2 combine
ORP A,<expr> 84 1 1 plain
ORP B,<expr> 94 1 1 plain
ORP %<expr>,<expr> A4 1 2 combine
POP A B9 1 0 plain
POP B C9 1 0 plain
POP ST 08 1 0 plain
POP <expr> D9 1 1 plain
POPST - 08 1 0 plain
PUSH A B8 1 0 plain
PUSH B C8 1 0 plain
PUSH ST 0E 1 0 plain
PUSH <expr> D8 1 1 plain
PUSHST - 0E 1 0 plain
RETI - 0B 1 0 plain
